# ============================================================
#  agentic-reviewer  –  Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── LLM API Keys ─────────────────────────────────────────────
# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Ollama base URL for local models (no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Routing ──────────────────────────────────────────────
# Primary model for complex reasoning tasks
PRIMARY_MODEL=gemini/gemini-3.5-flash
# Fast / cheap model for triage, classification, short prompts
FAST_MODEL=groq/openai/gpt-oss-20b
# Fallback if both primary and fast fail
FALLBACK_MODEL=ollama/qwen2.5-coder:7b

# ── GitHub App (Mode A only) ──────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github_app.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_INSTALLATION_ID=

# ── Semgrep ───────────────────────────────────────────────────
# Optional: Semgrep Cloud token for pro rules (free account available)
SEMGREP_APP_TOKEN=

# ── Application ───────────────────────────────────────────────
# Environment: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# SQLite state database path
DATABASE_URL=sqlite+aiosqlite:///./data/agentic_reviewer.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# Docker socket path (for merge simulation sandbox)
DOCKER_SOCKET=unix:///var/run/docker.sock

# Maximum retry loops before escalating to human
MAX_FIX_ITERATIONS=3

# Webhook server port (Mode A)
WEBHOOK_PORT=8080

# Streamlit dashboard port (approval UI)
DASHBOARD_PORT=8501
